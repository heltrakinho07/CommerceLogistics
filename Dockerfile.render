# Single-service Render deployment: React static build + FastAPI API.
# Existing docker-compose.yml retains its independent Nginx / Python services.
FROM node:22-alpine AS web-build
WORKDIR /web
COPY apps/web/package*.json ./
RUN npm install --no-audit --no-fund
COPY apps/web/ ./
RUN npm run build

FROM python:3.12-slim AS runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/services/api \
    FRONTEND_DIST_DIR=/app/frontend
COPY services/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY services/api/app /app/services/api/app
COPY data/sample /app/data/sample
COPY ml/train_shipping.py /app/ml/train_shipping.py
RUN python /app/ml/train_shipping.py > /app/training-report.json
COPY --from=web-build /web/dist /app/frontend
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 10000
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
